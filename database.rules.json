{
  "rules": {
    ".read": false,
    ".write": false,

    "game": {
      ".read": true,
      "active": {
        ".write": "auth != null && root.child('secret/host_key').exists() && root.child('hostAuth').child(auth.uid).val() === root.child('secret/host_key').val()",
        ".validate": "newData.isBoolean()"
      },
      "force": {
        ".write": "auth != null && root.child('secret/host_key').exists() && root.child('hostAuth').child(auth.uid).val() === root.child('secret/host_key').val()",
        ".validate": "newData.isBoolean()"
      },
      "target": {
        ".write": "auth != null && root.child('secret/host_key').exists() && root.child('hostAuth').child(auth.uid).val() === root.child('secret/host_key').val()",
        ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10000000"
      },
      "live": {
        ".write": "auth != null && root.child('secret/host_key').exists() && root.child('hostAuth').child(auth.uid).val() === root.child('secret/host_key').val()",
        ".validate": "newData.isBoolean()"
      },
      "round": {
        ".write": "auth != null && root.child('secret/host_key').exists() && root.child('hostAuth').child(auth.uid).val() === root.child('secret/host_key').val()",
        ".validate": "newData.isString() && newData.val().length <= 20"
      },
      "total": {
        ".write": "auth != null && ((root.child('secret/host_key').exists() && root.child('hostAuth').child(auth.uid).val() === root.child('secret/host_key').val()) || (root.child('game/active').val() === true && !root.child('reveal').exists() && newData.isNumber() && ((!data.exists() && newData.val() >= 1 && newData.val() <= 60) || (data.exists() && newData.val() > data.val() && newData.val() <= data.val() + 60))))",
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "$other": { ".validate": false }
    },

    "clicks": {
      ".read": true,
      ".write": "auth != null && root.child('secret/host_key').exists() && root.child('hostAuth').child(auth.uid).val() === root.child('secret/host_key').val()",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && root.child('game/active').val() === true && !root.child('reveal').exists() && newData.isNumber() && ((!data.exists() && newData.val() >= 1 && newData.val() <= 60) || (data.exists() && newData.val() > data.val() && newData.val() <= data.val() + 60))"
      }
    },

    "votes": {
      ".read": true,
      ".write": "auth != null && root.child('secret/host_key').exists() && root.child('hostAuth').child(auth.uid).val() === root.child('secret/host_key').val()",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !root.child('reveal').exists() && (!data.exists() || newData.child('nickname').val() === data.child('nickname').val())",
        ".validate": "newData.hasChildren(['nickname', 'wish', 'ts'])",
        "nickname": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
        "team": { ".validate": "newData.val() === 'BOY' || newData.val() === 'GIRL'" },
        "wish": { ".validate": "newData.isString() && newData.val().length <= 160" },
        "ts": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },

    "presence": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "at": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "reveal": {
      ".read": true,
      ".write": "auth != null && ((!newData.exists() && root.child('secret/host_key').exists() && root.child('hostAuth').child(auth.uid).val() === root.child('secret/host_key').val()) || (!data.exists() && newData.child('gender').val() === root.child('secret/gender').val() && (root.child('game/force').val() === true || (root.child('game/live').val() !== true && root.child('game/total').val() >= root.child('game/target').val()))))",
      ".validate": "newData.hasChildren(['gender', 'at'])",
      "gender": { ".validate": "newData.val() === 'BOY' || newData.val() === 'GIRL'" },
      "at": { ".validate": "newData.isNumber() && newData.val() <= now + 5000 && newData.val() >= now - 60000" },
      "$other": { ".validate": false }
    },

    "clues": {
      ".read": true,
      ".write": "auth != null && root.child('secret/host_key').exists() && root.child('hostAuth').child(auth.uid).val() === root.child('secret/host_key').val()",
      "$key": {
        ".validate": "$key.length <= 16 && newData.hasChildren(['side', 'at'])",
        "side": { ".validate": "newData.val() === 'BOY' || newData.val() === 'GIRL'" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "at": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },

    "bet": {
      ".read": true,
      ".write": "auth != null && root.child('secret/host_key').exists() && root.child('hostAuth').child(auth.uid).val() === root.child('secret/host_key').val()",
      "cfg": {
        ".validate": "newData.hasChildren(['on', 'verb', 'unit', 'per'])",
        "on": { ".validate": "newData.isBoolean()" },
        "verb": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
        "unit": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
        "per": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100 && newData.val() % 1 === 0" },
        "boostOn": { ".validate": "newData.isBoolean()" },
        "switchOn": { ".validate": "newData.isBoolean()" },
        "godOn": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      },
      "lock": { ".validate": "newData.isBoolean()" },
      "boost": { ".validate": "newData.isNumber()" },
      "stakes": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('bet/cfg/on').val() === true && !root.child('reveal').exists() && ((root.child('bet/lock').val() !== true && root.child('game/active').val() !== true && data.child('lk').val() !== true) || root.child('bet/boost').val() > now)",
          ".validate": "newData.hasChildren(['b', 'g', 'lk', 'pen', 'bw', 'ts']) && newData.child('b').val() + newData.child('g').val() >= 5 && newData.child('b').val() + newData.child('g').val() <= 10",
          "b": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10 && newData.val() % 1 === 0" },
          "g": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10 && newData.val() % 1 === 0" },
          "lk": { ".validate": "newData.isBoolean()" },
          "pen": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20 && newData.val() % 1 === 0" },
          "bw": { ".validate": "newData.isNumber()" },
          "ts": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      },
      "$other": { ".validate": false }
    },

    "media": {
      "key": {
        ".read": "root.child('reveal').exists()",
        ".write": "auth != null && root.child('secret/host_key').exists() && root.child('hostAuth').child(auth.uid).val() === root.child('secret/host_key').val()",
        ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 100"
      },
      "on": {
        ".read": true,
        ".write": "auth != null && root.child('secret/host_key').exists() && root.child('hostAuth').child(auth.uid).val() === root.child('secret/host_key').val()",
        ".validate": "newData.isBoolean()"
      },
      "has_key": {
        ".read": true,
        ".write": "auth != null && root.child('secret/host_key').exists() && root.child('hostAuth').child(auth.uid).val() === root.child('secret/host_key').val()",
        ".validate": "newData.isBoolean()"
      }
    },

    "secret": {
      ".read": false,
      "gender": {
        ".write": "auth != null && root.child('secret/host_key').exists() && root.child('hostAuth').child(auth.uid).val() === root.child('secret/host_key').val()",
        ".validate": "newData.val() === 'BOY' || newData.val() === 'GIRL'"
      },
      "clues": {
        ".read": "auth != null && root.child('secret/host_key').exists() && root.child('hostAuth').child(auth.uid).val() === root.child('secret/host_key').val()",
        ".write": "auth != null && root.child('secret/host_key').exists() && root.child('hostAuth').child(auth.uid).val() === root.child('secret/host_key').val()",
        "$key": {
          ".validate": "$key.length <= 16 && newData.hasChildren(['side'])",
          "side": { ".validate": "newData.val() === 'BOY' || newData.val() === 'GIRL'" },
          "note": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "$other": { ".validate": false }
        }
      }
    },

    "hostAuth": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().length <= 100"
      }
    }
  }
}
